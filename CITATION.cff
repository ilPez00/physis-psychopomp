    alias: "ilPez00"
version: 0.8.1
date-released: 2026-11-21
repository-code: "https://github.com/ilPez00/physis-psychopomp"
url: "https://github.com/ilPez00/physis-psychopomp"
keywords:
  - occlusion
  - possible worlds
  - event calculus
  - identity
  - reproducibility
